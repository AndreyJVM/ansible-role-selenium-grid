---
# Copy to vars.yml, replace values, then encrypt it with ansible-vault.
proxmox_api_host: "pve.example.lan"
proxmox_api_user: "ansible@pve"
proxmox_api_token_id: "selenium"
proxmox_api_token_secret: "REPLACE_WITH_TOKEN_SECRET"
proxmox_validate_certs: false # Set true when Proxmox has a trusted certificate.

proxmox_node: "pve"
proxmox_template_name: "ubuntu-2404-cloudinit-template"
proxmox_vm_name: "selenium-grid-01"
proxmox_vm_id: 901
proxmox_storage: "local-lvm"
proxmox_bridge: "vmbr0"

# Reserve this address for the VM in your LAN. Cloud-init sets it on the guest.
selenium_vm_ip: "192.168.1.90"
selenium_vm_cidr: 24
selenium_vm_gateway: "192.168.1.1"
selenium_vm_dns:
  - "192.168.1.1"

selenium_ssh_public_key_file: "~/.ssh/id_ed25519.pub"
selenium_vm_user: "deployer"
selenium_vm_cores: 4
selenium_vm_memory_mb: 8192
