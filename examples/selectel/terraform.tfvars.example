# Copy this file to terraform.tfvars and fill in your Selectel credentials
# DO NOT commit terraform.tfvars to version control!

selectel_account_id = "123456"                       # Your Selectel Account ID / Domain
selectel_project_id = "b1234567890abcdef1234567890a" # VPC Project UUID from Selectel Console
selectel_user_name  = "selenium-terraform-user"      # Service user or account username
selectel_password   = "REPLACE_WITH_USER_PASSWORD"   # Password for the user

# Region & Pool
# SPb: ru-9a (Dubrovka), ru-2a (Tsvetochnaya)
# Moscow: ru-7a (Berzarina)
region              = "ru-9a"
volume_type         = "fast.ru-9a"

# Server Hardware (c4m8-d0: 4 vCPU, 8 GB RAM, perfect for 3-4 parallel browsers)
flavor_name         = "c4m8-d0"
volume_size         = 30
server_name         = "selenium-grid-01"

# SSH Key
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
